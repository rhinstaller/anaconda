#!/bin/bash
#
# Build a boot.iso with image-builder (osbuild). The boot.iso will be stored
# in the `/images/` directory. We have to build the RPM files of Anaconda
# first and then add them as volume mount to /anaconda-rpms to the container
# (could be RO mount).
#
#   sudo make -f ./Makefile.am container-rpms-scratch
#   sudo podman run -i --rm --privileged --tmpfs /var/tmp:rw,mode=1777 -v `pwd`/result/build/01-rpm-build:/anaconda-rpms:ro -v `pwd`/output-dir:/images:z quay.io/rhinstaller/anaconda-iso-creator:main
#
# Input directory:
# /anaconda-rpms/ (Anaconda RPM files for the build)
#
# Output directory:
# /images (Where the boot.iso will be stored)
#

set -eux

# pre-create loop devices manually. In the container you can't use losetup for that.
mknod -m 0660 /dev/loop0 b 7 0  2> /dev/null || true
mknod -m 0660 /dev/loop1 b 7 1  2> /dev/null || true

# image-builder relabels its cache dir with SELinux contexts (chcon). That
# fails with "Operation not supported" when the container's root filesystem
# sits on a backend that doesn't support SELinux xattrs (e.g. overlay on top
# of btrfs - a known podman/btrfs limitation, independent of this build).
# Mount a tmpfs over it so this always works regardless of the host's podman
# storage driver.
mkdir -p /var/cache/image-builder
mount -t tmpfs tmpfs /var/cache/image-builder

INPUT_RPMS=/anaconda-rpms/
OUT_DIR=/images/
REPO_DIR=/tmp/anaconda-rpms/

# create repo from provided Anaconda RPMs
mkdir -p $REPO_DIR
cp -a $INPUT_RPMS/* $REPO_DIR || echo "RPM files can't be copied!"  # We could just do the build with official repositories only
createrepo_c $REPO_DIR

. /etc/os-release

{% if distro_name == "fedora" %}
if [ "$CI_TAG" = "fedora-eln" ]; then
    echo "fedora-eln is not supported by the image-builder based build yet" >&2
    exit 1
fi
# image-builder doesn't know the "fedora-rawhide" alias, only numbered
# versions (e.g. "fedora-46") - VERSION_ID from /etc/os-release of this
# very container is already the current Rawhide version number, so use that
# regardless of whether CI_TAG says "fedora-rawhide" or "fedora-<N>".
IMAGE_BUILDER_DISTRO="fedora-${VERSION_ID}"

mkdir -p output
# "everything-network-installer" is Fedora's generic, interactive,
# network-install Anaconda boot.iso - the image-builder equivalent of what
# lorax's runtime-install.tmpl built (the upstream distrodef literally notes
# "Based on lorax runtime-install.tmpl"). Not to be confused with the
# "network-installer" image_func name used internally, or the RHEL/CentOS
# Stream type of the same latter name.
image-builder build everything-network-installer \
      --distro "$IMAGE_BUILDER_DISTRO" \
      --extra-repo "file://$REPO_DIR/" \
      --output-dir output \
      "$@" || cp *.log "$OUT_DIR"
{% else %}
# This image-builder based build only covers Fedora for now. RHEL/CentOS
# Stream support was intentionally not ported over from the old lorax-based
# script - see dockerfile/anaconda-iso-creator for the previous approach.
echo "image-builder-build only supports Fedora right now (distro_name={$ distro_name $})" >&2
exit 1
{% endif %}

cp output/*.iso "$OUT_DIR/boot.iso"

# fix permissions to user permissions on the built artifacts
chown -Rv --reference="$INPUT_RPMS" "$OUT_DIR"
