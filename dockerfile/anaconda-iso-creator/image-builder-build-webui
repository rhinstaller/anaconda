#!/bin/bash
# ======================================
# WARNING!
# THIS FILE IS GENERATED FROM A TEMPLATE
# DO NOT EDIT THIS FILE MANUALLY!
# ======================================
# The template is located in: image-builder-build-webui.j2

#
# Build a Web UI boot.iso. There is no "Web UI" image type in image-builder
# (anaconda-webui isn't part of any upstream Fedora image-builder distro
# definition yet), so this builds the plain boot.iso with image-builder while
# asking it - through the blueprint's customizations.installer.packages
# customization - to install the Web UI packages into the Anaconda installer
# environment itself, and then patches the boot menu of the result:
#  - image-builder installs anaconda-webui/cockpit-ws/cockpit-bridge/firefox/
#    dbus-glib into the ISO's Anaconda environment
#  - turns the default boot menu entry into two Web UI entries: a default
#    local one (inst.webui) and a remote one (inst.webui inst.webui.remote)
#
# customizations.installer.packages is newer than the released image-builder,
# so building this needs an image-builder that provides it.
#
# To run this please do:
#
#   sudo make -f ./Makefile.am container-rpms-scratch
#   sudo podman run -i --rm --privileged --tmpfs /var/tmp:rw,mode=1777 -v `pwd`/result/build/01-rpm-build:/anaconda-rpms:ro -v `pwd`/output-dir:/images:z --entrypoint /image-builder-build-webui quay.io/rhinstaller/anaconda-iso-creator:main
#
#
# Input directory:
# /anaconda-rpms/ (Anaconda RPM files for the build)
#
# Output directory:
# /images (Where the boot.iso will be stored)
#

set -eux

OUT_DIR=/images/
BLUEPRINT=/tmp/webui-blueprint.toml

. /etc/os-release

if [ "$CI_TAG" = "fedora-rawhide" ]; then
    FEDORA_VERSION="rawhide"
else
    FEDORA_VERSION=${CI_TAG#fedora-}
fi

# Check for COPR repositories from pull requests
EXTRA_REPO_ARGS=()

# Function to add COPR repository if PR variable is set
add_copr_repo() {
    local pr_var_name="$1"
    local copr_project_path="$2"
    local project_name="$3"
    local pr_number="${!pr_var_name:-}"

    if [ -n "${pr_number}" ]; then
        local copr_url="https://download.copr.fedorainfracloud.org/results/packit/${copr_project_path}-${pr_number}/fedora-${FEDORA_VERSION}-x86_64/"
        EXTRA_REPO_ARGS+=("--extra-repo" "${copr_url}")
        echo "Using ${project_name} COPR from PR #${pr_number}: ${copr_url}"
    fi
}

# Add COPR repositories for anaconda-webui and cockpit
add_copr_repo "ANACONDA_WEBUI_PR" "rhinstaller-anaconda-webui" "anaconda-webui"
add_copr_repo "COCKPIT_PR" "cockpit-project-cockpit" "cockpit"

# Blueprint asking image-builder to install the Web UI packages into the
# Anaconda installer environment as part of the build itself, instead of
# patching them in afterwards. The freshly built Anaconda RPMs (added as an
# extra repo by image-builder-build) and the COPRs above are available to it.
cat > "$BLUEPRINT" <<'EOF'
[customizations.installer]
packages = [
  { name = "anaconda-webui" },
  { name = "cockpit-ws" },
  { name = "cockpit-bridge" },
  { name = "firefox" },
  { name = "dbus-glib" },
]
EOF

# Build the pure image-builder boot.iso - same code path as the non-webui
# build - with the Web UI packages baked into the Anaconda environment.
/image-builder-build --blueprint "$BLUEPRINT" "${EXTRA_REPO_ARGS[@]}" "$@"

STOCK_ISO="$OUT_DIR/boot.iso"
WORKDIR=$(mktemp -d)
ISO_TREE="$WORKDIR/iso-tree"
mkdir -p "$ISO_TREE"

# Extract the whole ISO content as plain files (no loop mount needed to read it).
xorriso -osirrox on -indev "$STOCK_ISO" -extract / "$ISO_TREE"

# Turn the first boot menu entry in each generated boot menu config into two
# Web UI entries - a default local one and a remote one - and collect them as
# the set of files to splice back into the ISO.
UPDATE_ARGS=()
while IFS= read -r -d '' cfg; do
    python3 /add_webui_boot_entries.py "$cfg"
    UPDATE_ARGS+=(-update "$cfg" "/${cfg#$ISO_TREE/}")
done < <(find "$ISO_TREE" \( -iname 'grub.cfg' -o -iname 'isolinux.cfg' -o -iname 'grub2-bios.cfg' -o -iname 'grub2-efi.cfg' \) -print0)

# Reassemble the ISO, replacing just the boot menu configs, keeping the
# original El Torito boot catalog/boot images intact. xorriso can't write to
# the same path it reads from, so build into a temp file and move it over the
# original once done.
NEW_ISO="$WORKDIR/boot.iso.new"
xorriso -indev "$STOCK_ISO" -outdev "$NEW_ISO" \
    -boot_image any replay \
    "${UPDATE_ARGS[@]}"
mv "$NEW_ISO" "$STOCK_ISO"

rm -rf "$WORKDIR"
